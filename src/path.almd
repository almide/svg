// svg.path — SVG path command builder
//
//   import svg.path
//   path.d([path.move_to(0.0, 0.0), path.line_to(100.0, 50.0), path.close()])
//   → "M0 0 L100 50 Z"

// ── Helpers ─────────────────────────────────────────

// Whole numbers print without ".0". float.to_fixed exists on every dialect
// epoch (float.to_int is gone at epoch 15); "+ 0.0" turns -0.0 into "0".
local fn fmt(n: Float) -> String =
  if n == float.floor(n) then float.to_fixed(n + 0.0, 0)
  else float.to_string(n)

// ── Commands ────────────────────────────────────────

fn move_to(x: Float, y: Float) -> String =
  "M${fmt(x)} ${fmt(y)}"

fn line_to(x: Float, y: Float) -> String =
  "L${fmt(x)} ${fmt(y)}"

fn h_line(x: Float) -> String =
  "H${fmt(x)}"

fn v_line(y: Float) -> String =
  "V${fmt(y)}"

fn cubic(x1: Float, y1: Float, x2: Float, y2: Float, x: Float, y: Float) -> String =
  "C${fmt(x1)} ${fmt(y1)}, ${fmt(x2)} ${fmt(y2)}, ${fmt(x)} ${fmt(y)}"

fn smooth_cubic(x2: Float, y2: Float, x: Float, y: Float) -> String =
  "S${fmt(x2)} ${fmt(y2)}, ${fmt(x)} ${fmt(y)}"

fn quad(x1: Float, y1: Float, x: Float, y: Float) -> String =
  "Q${fmt(x1)} ${fmt(y1)}, ${fmt(x)} ${fmt(y)}"

fn smooth_quad(x: Float, y: Float) -> String =
  "T${fmt(x)} ${fmt(y)}"

fn arc(rx: Float, ry: Float, rotation: Float, large: Int, sweep: Int, x: Float, y: Float) -> String =
  "A${fmt(rx)} ${fmt(ry)} ${fmt(rotation)} ${int.to_string(large)} ${int.to_string(sweep)} ${fmt(x)} ${fmt(y)}"

fn close() -> String = "Z"

fn d(commands: List[String]) -> String =
  commands |> list.join(" ")

// ── Tests ───────────────────────────────────────────

test "move and line" {
  let p = d([move_to(0.0, 0.0), line_to(100.0, 200.0)])
  assert_eq(p, "M0 0 L100 200")
}

test "closed triangle" {
  let p = d([move_to(0.0, 0.0), line_to(50.0, 50.0), line_to(100.0, 0.0), close()])
  assert_eq(p, "M0 0 L50 50 L100 0 Z")
}

test "cubic bezier" {
  let p = cubic(10.0, 20.0, 30.0, 40.0, 50.0, 60.0)
  assert_eq(p, "C10 20, 30 40, 50 60")
}

test "quadratic bezier" {
  let p = quad(10.0, 20.0, 30.0, 40.0)
  assert_eq(p, "Q10 20, 30 40")
}

test "arc command" {
  let p = arc(25.0, 25.0, 0.0, 0, 1, 50.0, 50.0)
  assert_eq(p, "A25 25 0 0 1 50 50")
}

test "h_line and v_line" {
  let p = d([h_line(100.0), v_line(200.0)])
  assert_eq(p, "H100 V200")
}

test "fractional coordinates" {
  let p = d([move_to(10.5, 20.3), line_to(30.7, 40.1)])
  assert_eq(p, "M10.5 20.3 L30.7 40.1")
}
